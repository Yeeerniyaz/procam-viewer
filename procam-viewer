#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ProCam Viewer v4.1 — CLI Launcher & Diagnostics Engine
"""
import os
import sys
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
BIN_LINUX = os.path.join(SCRIPT_DIR, "dist", "linux", "ProCamViewer_Linux_x64")

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("ProCam Viewer v4.1 — Кроссплатформенный комплекс видеонаблюдения")
        print("Использование:")
        print("  procam-viewer              Запуск графического мультиэкранного плеера")
        print("  procam-viewer --headless   Запуск фонового стриминг-сервера API")
        print("  procam-viewer --help       Справка")
        return

    if os.path.isfile(BIN_LINUX) and os.access(BIN_LINUX, os.X_OK):
        os.execv(BIN_LINUX, [BIN_LINUX] + sys.argv[1:])
    else:
        # Fallback to dev or python runner
        print(f"[ProCam Viewer] Бинарник {BIN_LINUX} не найден. Запуск сборки или Dev-режима...")
        try:
            subprocess.run(["npm", "run", "dev"], cwd=SCRIPT_DIR, check=True)
        except Exception as e:
            print(f"[!] Ошибка запуска: {e}")

if __name__ == "__main__":
    main()
