{
  "name": "procam-viewer",
  "private": true,
  "version": "4.1.0",
  "description": "ProCam Viewer — Professional Cross-Platform CCTV Surveillance & Stream Diagnostics Suite (Windows & Linux)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
